APP_ENV=development
APP_NAME=MyAI Backend
DEBUG=true

# --- Datastores ---
DATABASE_URL=postgresql+asyncpg://myai:myai@postgres:5432/myai
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Hugging Face ---
# A single token that can call every model on the account is normally enough.
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only set these if GLM and Kimi genuinely require separate credentials:
# HF_GLM_TOKEN=
# HF_KIMI_TOKEN=

# Model identifiers are looked up on Hugging Face at runtime - change these
# without touching any code. Point them at whatever GLM-5.2 / Kimi K3
# deployment (or any other chat model) you actually have access to.
GLM_MODEL_ID=zai-org/GLM-4.6
KIMI_MODEL_ID=moonshotai/Kimi-K2-Instruct
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# --- Observability ---
SENTRY_DSN=

# --- HTTP / security ---
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=20

# --- Rate limiting ---
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# --- docker-compose Postgres bootstrap (used by the postgres service only) ---
POSTGRES_USER=myai
POSTGRES_PASSWORD=myai
POSTGRES_DB=myai
